# TDCP Attendance System - Environment Configuration
# Copy to .env and fill in values. Never commit .env to version control.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
TZ=Asia/Karachi

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tdcp_app
DB_PASSWORD=change_me_strong_password
DB_NAME=tdcp_attendance_db
DB_CONNECTION_LIMIT=20

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Mobile attendance (disabled by default)
MOBILE_ATTENDANCE_ENABLED=false

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1
